// CADL Expression Grammar for Lark parser
// Used for parsing predicate expressions, protocol steps, etc.
// The top-level YAML-like structure is handled by the YAML parser.

start: predicate_expr

// === Predicates ===
// Precedence, loosest to tightest: OR, AND, NOT, comparison, + -, * /
// A quantifier scopes over everything to its right.
?predicate_expr: quantified_expr
               | or_expr

?or_expr: and_expr ("OR" and_expr)+     -> or_expr
        | and_expr
?and_expr: not_expr ("AND" not_expr)+   -> and_expr
         | not_expr
?not_expr: "NOT" not_expr               -> not_expr
         | comparison

?comparison: expr COMP_OP expr          -> comparison
           | expr

quantified_expr: QUANTIFIER IDENTIFIER "in" expr ":" predicate_expr
QUANTIFIER: "for all" | "exists"

// === Arithmetic ===
// The operators are named terminals so that they survive into the parse
// tree; anonymous string tokens are filtered out by Lark.
?expr: term (ADD_OP term)+              -> arith_expr
     | term
?term: factor (MUL_OP factor)+          -> term_expr
     | factor
?factor: "(" predicate_expr ")"         -> grouped
       | function_call
       | member_access
       | atom

function_call: IDENTIFIER "(" [arg_list] ")"
arg_list: arg ("," arg)*
?arg: predicate_expr | STRING

member_access: IDENTIFIER ("." IDENTIFIER)+

// === Atoms ===
?atom: FLOAT                            -> float_lit
     | INT                              -> int_lit
     | BOOL                             -> bool_lit
     | STRING                           -> string_lit
     | DURATION_LIT                     -> duration_lit
     | actor_ref                        -> actor_ref_expr

// === Actor references ===
actor_ref: IDENTIFIER "[" WILDCARD "]"  -> actor_ref_wild
         | IDENTIFIER "[" INT ".." (INT | IDENTIFIER) "]" -> actor_ref_range
         | IDENTIFIER "[" expr "]"      -> actor_ref_index
         | IDENTIFIER                   -> actor_ref_simple

WILDCARD: "*"

// === Arithmetic operators ===
ADD_OP: "+" | "-"
MUL_OP: "*" | "/"

// === Comparison operators ===
COMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"

// === Literals ===
BOOL: "true" | "false"
DURATION_LIT: /\d+(ms|s|min|h)/
STRING: /\"[^\"]*\"/

%import common.INT
%import common.FLOAT
%import common.WS
// Keywords are not identifiers, so "NOT (a)" is never read as a call.
IDENTIFIER: /(?!(?:AND|OR|NOT|true|false)\b)[a-zA-Z_][a-zA-Z0-9_]*/

%ignore WS
