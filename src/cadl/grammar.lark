// CADL Expression Grammar for Lark parser
// Used for parsing predicate expressions, protocol steps, etc.
// The top-level YAML-like structure is handled by the YAML parser.

start: predicate_expr

// === Predicates ===
// Precedence, loosest to tightest: OR, AND, NOT, comparison, + -, * /
// A quantifier may stand wherever a comparison may (after AND / OR / NOT)
// and scopes over everything to its right, so it is always the last
// operand of the chain it appears in. The "_open" rules are the forms
// that end in a quantifier; keeping them apart makes the grammar
// unambiguous.
?predicate_expr: or_open
               | or_expr

?or_expr: and_expr (_OR and_expr)+      -> or_expr
        | and_expr
?and_expr: not_expr (_AND not_expr)+    -> and_expr
         | not_expr
?not_expr: _NOT not_expr                -> not_expr
         | comparison

?or_open: (and_expr _OR)+ and_open      -> or_expr
        | and_open
?and_open: (not_expr _AND)+ not_open    -> and_expr
         | not_open
?not_open: _NOT not_open                -> not_expr
         | quantified_expr

?comparison: expr COMP_OP expr          -> comparison
           | expr

quantified_expr: QUANTIFIER IDENTIFIER _IN expr ":" predicate_expr
QUANTIFIER: /(?:for\s+all|exists)(?![A-Za-z0-9_])/

// === Arithmetic ===
// The operators are named terminals so that they survive into the parse
// tree; anonymous string tokens are filtered out by Lark.
?expr: term (ADD_OP term)+              -> arith_expr
     | term
?term: factor (MUL_OP factor)+          -> term_expr
     | factor
?factor: "(" predicate_expr ")"         -> grouped
       | function_call
       | member_access
       | atom

function_call: IDENTIFIER "(" [arg_list] ")"
arg_list: arg ("," arg)*
?arg: comprehension | predicate_expr | STRING

// Aggregate over a range or set: sum(ROBOT[i].goal_count for i in 1..5)
comprehension: predicate_expr _FOR IDENTIFIER _IN comp_domain
?comp_domain: INT ".." (INT | IDENTIFIER)  -> range_domain
            | expr

// The object may be indexed: ROBOT[i].battery, ROBOT[*].status
member_access: actor_ref ("." IDENTIFIER)+

// === Atoms ===
?atom: FLOAT                            -> float_lit
     | INT                              -> int_lit
     | BOOL                             -> bool_lit
     | STRING                           -> string_lit
     | DURATION_LIT                     -> duration_lit
     | actor_ref                        -> actor_ref_expr

// === Actor references ===
actor_ref: IDENTIFIER "[" WILDCARD "]"  -> actor_ref_wild
         | IDENTIFIER "[" INT ".." (INT | IDENTIFIER) "]" -> actor_ref_range
         | IDENTIFIER "[" expr "]"      -> actor_ref_index
         | IDENTIFIER                   -> actor_ref_simple

WILDCARD: "*"

// === Arithmetic operators ===
ADD_OP: "+" | "-"
MUL_OP: "*" | "/"

// === Comparison operators ===
COMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"

// === Literals ===
BOOL: /(?:true|false)(?![A-Za-z0-9_])/

// === Keywords ===
// A keyword ends at a word boundary, so NOT_READY, ORDER or inventory are
// identifiers and are never split into a keyword plus a remainder.
_AND: /AND(?![A-Za-z0-9_])/
_OR: /OR(?![A-Za-z0-9_])/
_NOT: /NOT(?![A-Za-z0-9_])/
_IN: /in(?![A-Za-z0-9_])/
_FOR: /for(?![A-Za-z0-9_])/
DURATION_LIT: /\d+(ms|s|min|h)/
STRING: /\"[^\"]*\"/

%import common.INT
%import common.FLOAT
%import common.WS
// Reserved keywords (spec A.11, E.3) are not identifiers, so "NOT (a)" is
// never read as a call. "for all" is matched as a phrase by QUANTIFIER.
IDENTIFIER: /(?!(?:AND|OR|NOT|IN|true|false|in|exists)\b)[a-zA-Z_][a-zA-Z0-9_]*/

%ignore WS
