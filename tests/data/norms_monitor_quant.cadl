# A contract whose triggers, contents, untils, counts-as rules and
# assume: / guarantee: items quantify over a set with a symbolic bound
# (S[1..N]): the domain is open until the trace gives N a value (F.5).
# tests/test_norms_quantifiers.py checks the prefix property on random
# traces of it, and tests/test_norms_monitor.py compares the generated
# monitor with `cadl norms-eval` on them.

sos:
  name: Quant
  extensions:
    - sos-dsl: 0.1
    - norms: 0.1
  actors:
    - {id: D, role: d}
    - {id: "S[1..N]", role: s}
  contracts:
    - id: C
      parties: [D, "S[*]"]
      assume:
        - "D.up == true"
      guarantee:
        - "for all j in S: S[j].load < 9"
        - "within(5s, exists j in S: S[j].job == 7)"
      lifecycle:
        states: [Open, Closed]
        initial: Open
        terminal: [Closed]
        transitions:
          - {id: close, from: Open, to: Closed, on: "D -> S[i] : release"}
      counts_as:
        - {when: "exists j in S: S[j].load > 8", creates: overload}
        - {when: "D -> S[i] : assign", creates: assigned, if: "count(S[j].job == 7 for j in S) < 2"}
      norms:
        - id: double
          kind: prohibition
          bearer: D
          content: "exists j in S: exists k in S: j != k AND S[j].job == 7 AND S[k].job == 7"
          deadline: 6s
          on_violation: {severity: Critical}
        - id: busy_ack
          kind: obligation
          bearer: "S[i]"
          trigger: overload
          content: "S[i] -> D : ack"
          deadline: 4s
        - id: may_assign
          kind: permission
          bearer: D
          content: "D -> S[i] : assign"
          until: "for all j in S: S[j].job == 0"
        - id: all_light
          kind: prohibition
          bearer: D
          trigger: "exists j in S[2..N]: S[j].job == 7"
          content: "for all j in S[2..3]: S[j].load < 6"
          deadline: 3s
        - id: settle
          kind: obligation
          bearer: D
          trigger: assigned
          content: "exists j in S: within(3s, S[j].job == 0 AND S[j].load <= 5)"
          deadline: 6s
