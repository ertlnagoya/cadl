sos:
  name: "QH"
  extensions:
    - norms: 0.1
    - agents: 0.1
  actors:
    - { id: OP, role: "operator", agent: { kind: human } }
    - { id: AG, role: "agent", agent: { kind: llm_agent } }
    - { id: TOOL, role: "tool", agent: { kind: tool_server, tools: [act] } }
  contracts:
    - id: C
      parties: [OP, AG, TOOL]
      enforcement: {}
      norms:
        - { id: no_ping, kind: prohibition, bearer: AG, content: "AG -> OP : ping" }
