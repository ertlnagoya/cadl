sos:
  name: "X2"
  extensions:
    - norms: 0.1
    - agents: 0.1
  actors:
    - id: OP
      role: "approver"
      agent: { kind: human }
    - id: OWNER
      role: "owner of B"
      agent: { kind: human }
    - id: AG
      role: "agent"
      agent: { kind: llm_agent }
    - id: TOOL
      role: "tool"
      agent: { kind: tool_server, tools: [act, read] }
  contracts:
    - id: CA
      parties: [OP, AG, TOOL]
      enforcement: {}
      counts_as:
        - { when: "OP -> AG : approve", creates: approval }
        - { when: "OP -> AG : reject", creates: rejection }
      norms:
        - id: no_act
          kind: prohibition
          bearer: AG
          content: "AG -> TOOL : act"
          on_denied: { escalate_to: OP, timeout: 10min }
        - id: no_act2
          kind: prohibition
          bearer: AG
          content: "AG -> TOOL : act"
          on_amendment: carry_over
    - id: CB
      parties: [OWNER, AG, TOOL]
      enforcement: {}
      norms:
        - id: owner_act
          kind: permission
          bearer: OWNER
          content: "OWNER -> TOOL : act"
        - id: owner_read
          kind: permission
          bearer: OWNER
          content: "OWNER -> TOOL : read"
        - id: ag_read
          kind: permission
          bearer: AG
          until: "OWNER -> AG : stop"
          content: "AG -> TOOL : read"
      delegations:
        - { norm: owner_act, to: [AG], grant: grant_act, revoke: revoke_act }
