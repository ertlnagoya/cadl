sos:
  name: "W1"
  extensions:
    - norms: 0.1
    - agents: 0.1
  actors:
    - { id: OP, role: "approver", agent: { kind: human } }
    - { id: "SUP[1..3]", role: "supervisors", agent: { kind: human } }
    - { id: AG, role: "agent", agent: { kind: llm_agent } }
    - { id: TOOL, role: "tool", agent: { kind: tool_server, tools: [act, read, wipe] } }
  contracts:
    - id: C
      parties: [OP, "SUP[k]", AG, TOOL]
      enforcement: {}
      counts_as:
        - { when: "OP -> AG : approve", creates: approval }
        - { when: "OP -> AG : reject", creates: rejection }
        - { when: "SUP[k] -> AG : halt", creates: halted }
        - { when: "SUP[k] -> AG : bless", creates: blessed }
      norms:
        - id: no_act
          kind: prohibition
          bearer: AG
          content: "AG -> TOOL : act"
          on_denied: { escalate_to: OP, timeout: 10min }
        - { id: may_act, kind: permission, bearer: AG, content: "AG -> TOOL : act" }
        - { id: may_read, kind: permission, bearer: AG, content: "AG -> TOOL : read" }
        - { id: may_wipe, kind: permission, bearer: AG, trigger: blessed, content: "AG -> TOOL : wipe" }
        - id: can_pause
          kind: power
          bearer: "SUP[k]"
          content: "SUP[k] -> AG : pause"
          effects: { suspend: [no_act] }
        - id: can_arm
          kind: power
          bearer: "SUP[k]"
          content: "SUP[k] -> AG : arm"
          effects: { activate: [may_read] }
        - id: can_halt
          kind: power
          bearer: "SUP[k]"
          content: halted
          effects: { discharge: [no_act] }
