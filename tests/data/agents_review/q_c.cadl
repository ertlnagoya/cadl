sos:
  name: "QC"
  extensions:
    - norms: 0.1
    - agents: 0.1
  actors:
    - { id: OP, role: "operator", agent: { kind: human } }
    - { id: "W[1..3]", role: "workers", agent: { kind: llm_agent } }
    - { id: AG, role: "agent", agent: { kind: llm_agent } }
    - { id: TOOL, role: "tool", agent: { kind: tool_server, tools: [act, read, wipe] } }
  contracts:
    - id: C
      parties: [OP, "W[i]", AG, TOOL]
      enforcement: {}
      counts_as:
        - { when: "OP -> AG : approve", creates: approval }
        - { when: "OP -> AG : reject", creates: rejection }
        - { when: "OP -> AG : bless", if: "level > limit", creates: blessed }
      norms:
        - { id: may_act, kind: permission, bearer: AG, content: "AG -> TOOL : act" }
        - id: stop_act
          kind: prohibition
          bearer: AG
          trigger: "AG.mode == locked"
          until: "AG.mode == open"
          content: "AG -> TOOL : act"
          on_denied: { escalate_to: OP, timeout: 5min }
        - { id: may_read, kind: permission, bearer: AG, trigger: "W[i].ready == yes", until: "W[i].alarm == true", content: "AG -> TOOL : read" }
        - { id: may_wipe, kind: permission, bearer: AG, trigger: blessed, content: "AG -> TOOL : wipe" }
        - { id: no_wipe, kind: prohibition, bearer: AG, trigger: "level > limit + 5", deadline: 60s, content: "AG -> TOOL : wipe" }
    - id: D
      parties: [OP, AG, TOOL]
      enforcement: { default: allow }
      norms:
        - { id: d_stop, kind: prohibition, bearer: AG, trigger: "phase == final", content: "AG -> TOOL : read" }
