# The contract of tests/data/norms_wildcards.cadl with every predicate
# written as its quantified form (F.5) by hand.

sos:
  name: Wild
  extensions:
    - sos-dsl: 0.1
    - norms: 0.1
  actors:
    - {id: D, role: d}
    - {id: "R[1..3]", role: r}
    - {id: "S[1..N]", role: s}
  contracts:
    - id: C
      parties: [D, "R[*]", "S[*]"]
      assume:
        - "D.up == true"
        - "for all j in R: R[j].load >= 0"
      guarantee:
        - "for all j in S: S[j].load < 9"
        - "within(5s, for all j in S: S[j].job == 0)"
        - "sum(R[j].load for j in R) < 20"
        - "NOT (for all j in R[1..2]: R[j].load > 8)"
      lifecycle:
        states: [Open, Closed]
        initial: Open
        terminal: [Closed]
        transitions:
          - {id: close, from: Open, to: Closed, on: "D -> S[i] : release"}
      counts_as:
        - {when: "max(S[j].load for j in S) > 8", creates: overload}
        - {when: "D -> S[i] : assign", creates: assigned, if: "count(S[j].job == 7 for j in S[1..3]) < 2"}
      norms:
        - id: same_job
          kind: prohibition
          bearer: D
          content: "(for all j in R: for all k in S[1..2]: R[j].load > S[k].job) AND (for all j in R: R[j].job == R[j].job)"
        - id: busy_ack
          kind: obligation
          bearer: "S[i]"
          trigger: overload
          content: "S[i] -> D : ack"
          deadline: 4s
        - id: may_assign
          kind: permission
          bearer: D
          content: "D -> S[i] : assign"
          until: "(for all j in S: S[j].job == 0) OR (for all j in R: R[j].job == 0)"
        - id: light
          kind: prohibition
          bearer: D
          trigger: "(for all j in S[2..N]: S[j].job == 7) OR (for all j in R[2..3]: R[j].job == 7)"
          content: "NOT (for all j in S[2..3]: S[j].load < 6)"
        - id: settle
          kind: obligation
          bearer: D
          trigger: assigned
          content: "throughout(2s, (for all j in R: R[j].load <= 5) OR (for all j in S: S[j].job == 0))"
          deadline: 6s
