# Norms Extension: Amendment Demo, version 1 (Appendix F, F.6)
#
# The contract of norms_robot_delivery.cadl with on_amendment: policies
# that an amendment to norms_amendment_v2.cadl exercises:
#   acknowledge             carry_over (default); v2 shortens its deadline
#   report_failure          transform: request_help; v2 replaces it
#   no_low_battery_driving  carry_over; v2 changes its content
#   may_return_to_charge    discharge; v2 removes it
#   reassign                carry_over; v2 changes its effects
# Compare the versions with
#   cadl norms-diff examples/norms_amendment_v1.cadl examples/norms_amendment_v2.cadl
# and see examples/traces/norms_amendment_v1_to_v2.jsonl for a trace
# that is amended while the contract instance runs.

sos:
  name: "RobotDeliveryAmendment"
  type: Acknowledged
  version: "1.0.0"
  description: "Robot-delivery SoS used to demonstrate amendments of norms (version 1)."
  extensions:
    - sos-dsl: 0.1
    - norms: 0.1

  actors:
    - id: DISPATCHER
      role: "central_coordinator"
      autonomy: low
      capabilities:
        - assign_tasks
        - reassign_tasks
        - monitor_fleet
      interface:
        input:  [delivery_request, ack, failure_report, charging_request]
        output: [route_assignment, replan_command, delivery_notification]

    - id: "ROBOT[1..N]"
      role: "delivery_agent"
      autonomy: high
      capabilities:
        - follow_path
        - pick_up
        - deliver
      interface:
        input:  [route_assignment, replan_command]
        output: [ack, failure_report, charging_request]

    - id: "CUSTOMER[1..M]"
      role: "service_requester"
      autonomy: medium
      capabilities:
        - submit_order
        - confirm_receipt
      interface:
        input:  [delivery_notification]
        output: [delivery_request]

  contracts:
    - id: DELIVERY_SLA
      parties: [DISPATCHER, "ROBOT[*]", "CUSTOMER[*]"]
      assume:
        - "throughout(300s, DISPATCHER.is_operational == true)"
      guarantee:
        - "within(300s, ROBOT[i].status == Delivered)"

      lifecycle:
        states:   [Proposed, Assigned, Delivering, Completed, Violated]
        initial:  Proposed
        terminal: [Completed, Violated]
        transitions:
          - { id: assign,   from: Proposed,   to: Assigned,   on: "DISPATCHER -> ROBOT[i] : route_assignment" }
          - { id: start,    from: Assigned,   to: Delivering, on: "ROBOT[i].status == InTransit" }
          - { id: complete, from: Delivering, to: Completed,  on: "ROBOT[i].status == Delivered" }

      counts_as:
        - when: "DISPATCHER -> ROBOT[i] : replan_command"
          creates: reassignment

      norms:
        - id: acknowledge
          kind: obligation
          bearer: "ROBOT[i]"
          counterparty: DISPATCHER
          trigger: "DISPATCHER -> ROBOT[i] : route_assignment"
          content: "ROBOT[i] -> DISPATCHER : ack(accepted)"
          deadline: 5s
          on_violation:
            severity: Major
            reparation: report_failure
        - id: report_failure
          kind: obligation
          bearer: "ROBOT[i]"
          counterparty: DISPATCHER
          content: "ROBOT[i] -> DISPATCHER : failure_report"
          deadline: 2s
          on_violation:
            severity: Critical
            transition: Violated
          on_amendment: { transform: request_help }
        - id: no_low_battery_driving
          kind: prohibition
          bearer: "ROBOT[i]"
          content: "ROBOT[i].battery < 10 AND ROBOT[i].status == InTransit"
          on_violation:
            severity: Critical
            sanction: "removed from the dispatch pool for one period"
        - id: may_return_to_charge
          kind: permission
          bearer: "ROBOT[i]"
          content: "ROBOT[i] -> DISPATCHER : charging_request"
          on_amendment: discharge
        - id: reassign
          kind: power
          bearer: DISPATCHER
          content: reassignment
          effects:
            discharge: [acknowledge, report_failure]
