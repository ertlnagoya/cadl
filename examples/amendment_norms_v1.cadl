# =====================================================================
# amendment_norms_v1.cadl -- the orders of the robot town with norms
# (Appendix F) and the amendment extension (Appendix K), version 1.
#
# One contract instance of DELIVERY_SLA is one order. Version 2
# (amendment_norms_v2.cadl) shortens the pickup deadline from 120 s to
# 90 s from period 2 on; an order that is under way then switches to the
# new deadline only while it has not been picked up (in_states). Apply
# the versions to a trace, with a period of one hour (K.11):
#   cadl norms-eval amendment_norms_v1.cadl --version amendment_norms_v2.cadl \
#     --period 3600s --trace traces/amendment_norms_v1_a_switch.jsonl
# =====================================================================

sos:
  name: "RobotTownOrders"
  type: Collaborative
  version: "1"

  extensions:
    - sos-dsl: 0.1
    - norms: 0.1
    - amendment: 0.1

  actors:
    - id: TOWN_STEWARD
      role: "road_steward"
      autonomy: low
      capabilities: [assign_order]
    - id: "ROBOT[1..N]"
      role: "delivery_robot"
      autonomy: high
      capabilities: [pickup, dropoff]
    - id: OPERATOR
      role: "service_operator"
      autonomy: high
      capabilities: [decide_amendment]

  contracts:
    - id: DELIVERY_SLA
      parties: [TOWN_STEWARD, "ROBOT[*]"]
      lifecycle:
        states: [Assigned, PickedUp, Delivered]
        initial: Assigned
        terminal: [Delivered]
        transitions:
          - { id: pickup, from: Assigned, to: PickedUp, on: "ROBOT[i].status == PickedUp" }
          - { id: dropoff, from: PickedUp, to: Delivered, on: "ROBOT[i].status == Delivered" }
      norms:
        - id: pick_up
          kind: obligation
          bearer: "ROBOT[i]"
          counterparty: TOWN_STEWARD
          content: "ROBOT[i].status == PickedUp"
          deadline: 120s
          on_violation: { severity: Major }
        - id: deliver
          kind: obligation
          bearer: "ROBOT[i]"
          counterparty: TOWN_STEWARD
          trigger: "ROBOT[i].status == PickedUp"
          content: "ROBOT[i].status == Delivered"
          deadline: 120s
          on_violation: { severity: Major }

  amendment:
    effective: { period: 1 }
    layers:
      contract: { decided_by: OPERATOR }
    parameters:
      - id: pickup_deadline
        layer: contract
        value: 120s
        min: 60s
        max: 180s
        step: 30s
        at: [contracts.DELIVERY_SLA.norms.pick_up.deadline]
      - id: dropoff_deadline
        layer: contract
        value: 120s
        min: 60s
        max: 180s
        step: 30s
        at: [contracts.DELIVERY_SLA.norms.deliver.deadline]
